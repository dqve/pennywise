# Required in Vercel Production and Preview. Use a pooled, TLS-enabled Postgres connection.
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pennywise?sslmode=require
# Optional local SQLite path (only used when DATABASE_URL is absent and not hosted).
PENNYWISE_DB_PATH=./data/pennywise.sqlite
